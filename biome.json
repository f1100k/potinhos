{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/dist", "!.claude", "!src/app/routeTree.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "react": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/app/app.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/config/**",
        "src/hooks/**",
        "src/lib/**",
        "src/stores/**",
        "src/types/**",
        "src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/**", "**/features/**"],
                    "message": "Shared code does not depend on features or the app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/config/**",
        "src/lib/**",
        "src/stores/**",
        "src/types/**",
        "src/utils/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app/**",
                      "**/features/**",
                      "**/components/**",
                      "react",
                      "react-dom",
                      "@tanstack/*"
                    ],
                    "message": "Logic and state stay independent from React and the app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/coffee/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app/**",
                      "**/features/jars/**",
                      "**/features/settings/**"
                    ],
                    "message": "A feature does not import the app or another feature."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/jars/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app/**",
                      "**/features/coffee/**",
                      "**/features/settings/**"
                    ],
                    "message": "A feature does not import the app or another feature."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/settings/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/app/**",
                      "**/features/coffee/**",
                      "**/features/jars/**"
                    ],
                    "message": "A feature does not import the app or another feature."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
